@* NavMenu.razor *@
@inject iTender.Integrator.Demo.Services.ContractorAuthService Auth
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <i class="bi bi-buildings me-2"></i> cidb
        </a>
        
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="profile/{CrsNumber}">
                <i class="bi bi-person-badge me-2"></i> My Profile
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="opportunities">
                <i class="bi bi-briefcase me-2"></i> Opportunities
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="bids">
                <i class="bi bi-file-earmark-text me-2"></i> My Bids
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="contracts">
                <i class="bi bi-file-earmark-check me-2"></i> Contracts
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="compliance">
                <i class="bi bi-shield-check me-2"></i> Compliance
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="track-record">
                <i class="bi bi-graph-up-arrow me-2"></i> Track Record
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="documents">
                <i class="bi bi-folder me-2"></i> Documents
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                <i class="bi bi-bell me-2"></i> Notifications
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="help">
                <i class="bi bi-question-circle me-2"></i> Help & Support
            </NavLink>
        </div>

        @if (Auth.IsAuthenticated)
        {
            <div class="nav-user">
                <div class="nav-user-avatar">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div class="nav-user-info">
                    <div class="nav-user-name">@Auth.Current!.DisplayName</div>
                    <div class="nav-user-crs">CRS: @Auth.Current.CrsNumber</div>
                </div>
                <button class="nav-user-logout" @onclick="SignOut" title="Sign out">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        }

    </nav>
</div>

@code {
    private async Task SignOut()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }
}