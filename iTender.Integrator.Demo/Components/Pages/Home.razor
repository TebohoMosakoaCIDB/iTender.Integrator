@* Components/Pages/Home.razor *@
@page "/"
@rendermode InteractiveServer

@using System.Net
@using System.Text.Json
@using iTender.Integrator.Application.DTOs.Compliance
@using iTender.Integrator.Demo.Helpers
@using iTender.Integrator.Demo.Services
@using iTender.Integrator.Domain.Enums

@inject IntegratorApiClient Api
@inject ContractorAuthService Auth
@inject NavigationManager Nav

<PageTitle>Dashboard | iBidder</PageTitle>

<div class="dashboard-container">

    @if (!_authChecked)
    {
        <div class="loading-card">
            <div class="spinner-border"></div>
            <div>Loading your session...</div>
        </div>
    }
    else if (!Auth.IsAuthenticated)
    {
        <div class="loading-card">
            <div class="spinner-border"></div>
            <div>Redirecting to sign in...</div>
        </div>
    }
    else if (_loading)
    {
        <div class="loading-card">
            <div class="spinner-border"></div>
            <div>Loading your dashboard...</div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            <strong>Could not load dashboard</strong>
            <div>@_error</div>
            <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="LoadAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> Retry
            </button>
        </div>
    }
    else
    {
        <!-- Welcome Header -->
        <div class="dashboard-header">
            <div>
                <div class="eyebrow">Contractor Portal</div>
                <h1>Welcome, @Auth.Current!.DisplayName</h1>
                <p>
                    Here's an overview of your tenders, compliance, and opportunities.
                    <span class="crs-chip">
                        <i class="bi bi-hash"></i> CRS: @Auth.Current.CrsNumber
                    </span>
                </p>
            </div>

            <div class="api-status">
                <span class="status-dot"></span>
                API Connected
            </div>
        </div>

        @if (_loading)
        {
            <div class="loading-card">
                <div class="spinner-border"></div>
                <div>Loading your dashboard...</div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">
                <strong>Could not load dashboard</strong>
                <div>@_error</div>
                <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="LoadAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i> Retry
                </button>
            </div>
        }
        else
        {
            <!-- Stat Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon bg-navy"><i class="bi bi-briefcase"></i></div>
                    <div>
                        <div class="stat-label">Open Tenders</div>
                        <div class="stat-value">@_releaseCount</div>
                    </div>
                    <a href="/tenders" class="stat-link">View all</a>
                </div>

                <div class="stat-card">
                    <div class="stat-icon bg-navy"><i class="bi bi-file-earmark-text"></i></div>
                    <div>
                        <div class="stat-label">Submitted Bids</div>
                        <div class="stat-value">@_submittedCount</div>
                    </div>
                    <a href="/bids" class="stat-link">View all</a>
                </div>

                <div class="stat-card">
                    <div class="stat-icon bg-success"><i class="bi bi-trophy"></i></div>
                    <div>
                        <div class="stat-label">Awards Won</div>
                        <div class="stat-value">@_awardsWon</div>
                    </div>
                    <a href="/track-record" class="stat-link">View all</a>
                </div>

                <div class="stat-card">
                    <div class="stat-icon bg-navy"><i class="bi bi-file-earmark-check"></i></div>
                    <div>
                        <div class="stat-label">Active Contracts</div>
                        <div class="stat-value">@_activeContracts</div>
                    </div>
                    <a href="/contracts" class="stat-link">View all</a>
                </div>
            </div>

            <!-- Two-column: Compliance + Opportunities -->
            <div class="row g-4 mt-1">

                <!-- Compliance Status Card -->
                <div class="col-lg-4">
                    <div class="section-card h-100">
                        <div class="section-header">
                            <div>
                                <h2>Compliance Status</h2>
                                <p>Your regulatory standing</p>
                            </div>
                        </div>

                        @if (_compliance is null)
                        {
                            <p class="text-muted mb-0">No compliance record found.</p>
                        }
                        else
                        {
                            var status = _compliance.Status;
                            var heroClass = status switch
                            {
                                CidbComplianceStatus.Compliant => "status-compliant",
                                CidbComplianceStatus.NonCompliant => "status-noncompliant",
                                _ => "status-neutral"
                            };
                            var heroIcon = status switch
                            {
                                CidbComplianceStatus.Compliant => "bi bi-check-circle-fill",
                                CidbComplianceStatus.NonCompliant => "bi bi-x-circle-fill",
                                _ => "bi bi-info-circle-fill"
                            };

                            <div class="compliance-hero @heroClass">
                                <i class="@heroIcon"></i>
                                <div>
                                    <div class="compliance-status-text">@_compliance.StatusText</div>
                                    <div class="compliance-reason">@_compliance.Reason</div>
                                </div>
                            </div>

                            <ul class="compliance-list">
                                <li>
                                    <i class="bi bi-@(_compliance.CsdSupplierFound ? "check-circle-fill text-success" : "x-circle-fill text-danger")"></i>
                                    CSD Supplier Found
                                </li>
                                <li>
                                    <i class="bi bi-@(_compliance.CrmContractorFound ? "check-circle-fill text-success" : "x-circle-fill text-danger")"></i>
                                    CRM Contractor Linked
                                </li>
                            </ul>

                            <a href="/compliance" class="btn btn-outline-danger btn-sm w-100 mt-3">
                                View Compliance Details
                            </a>
                        }
                    </div>
                </div>

                <!-- Upcoming Opportunities -->
                <div class="col-lg-8">
                    <div class="section-card h-100">
                        <div class="section-header">
                            <div>
                                <h2>Upcoming Opportunities</h2>
                                <p>Tender releases relevant to your business</p>
                            </div>
                            <a href="/tenders" class="btn btn-dark btn-sm">View all</a>
                        </div>

                        @if (_releases.Count == 0)
                        {
                            <div class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <p>No upcoming tenders at the moment.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table integration-table">
                                    <thead>
                                        <tr>
                                            <th>Tender No</th>
                                            <th>Title</th>
                                            <th>Client</th>
                                            <th>Closing Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var release in _releases)
                                        {
                                            <tr>
                                                <td class="fw-semibold">
                                                    @GetValue(release, "ocid", "id")
                                                </td>
                                                <td>
                                                    @GetValue(release, "tender.title", "title")
                                                </td>
                                                <td>
                                                    @GetValue(release, "buyer.name", "procuringEntity.name")
                                                </td>
                                                <td>
                                                    @GetValue(release, "tender.tenderPeriod.endDate", "date")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private bool _authChecked;
    private string? _error;

    private int _releaseCount;
    private int _submittedCount;
    private int _awardsWon;
    private int _activeContracts;

    private ContractorComplianceResult? _compliance;
    private IReadOnlyList<JsonElement> _releases = [];

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    // Use OnAfterRenderAsync — this ONLY runs in the interactive pass,
    // never during pre-render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Auth.RestoreAsync();
        _authChecked = true;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        // Re-render now that we know who's logged in
        StateHasChanged();

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var crs = Auth.Current!.CrsNumber;
            var to = DateTime.Today;
            var from = to.AddDays(-60);

            var releasesTask = Api.GetOcdsReleasesAsync(1, 10, from, to);
            var complianceTask = Api.GetComplianceSupplierAsync(crs);
            var profileTask = Api.GetContractorAsync(crs);

            await Task.WhenAll(releasesTask, complianceTask, profileTask);

            var releasesElement = await releasesTask;
            _releases = JsonElementHelper.GetItems(releasesElement);
            _releaseCount = _releases.Count;

            var complianceElement = await complianceTask;
            _compliance = complianceElement.Deserialize<ContractorComplianceResult>(JsonOptions);

            // Discard profile for now — we just wanted to make sure it loads.
            _ = await profileTask;

            _submittedCount = 0;
            _awardsWon = 0;
            _activeContracts = 0;
        }
        catch (IntegratorApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _error = "Your contractor profile could not be found. Please sign in again.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetValue(JsonElement element, params string[] paths)
    {
        var value = JsonElementHelper.GetString(element, paths);
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }
}